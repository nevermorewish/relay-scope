// RelayScope - AI API 监测台数据模型（多分组版）
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ 核心表 ============

/// 上游中转站（站点级，保留元信息 + 汇总状态）
model Upstream {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  baseUrl   String
  type      String   @default("SUB2API")
  /// 汇总状态（由采集器聚合所有 key 的状态后回写）
  status    String   @default("UNKNOWN")
  enabled   Boolean  @default(true)
  priority  Int      @default(0)
  /// 每 1 元人民币可获得的美元额度，用于把美元计价换算为实际人民币成本
  creditUsdPerCny Float @default(1)
  /// 默认测速模型（新建 key 时继承，可被 key 级覆盖）
  testModel String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  keys           UpstreamKey[]
  metrics        Metric[]
  incidents      Incident[]
  prices         PriceSnapshot[]
  usageSnapshots UsageSnapshot[]
  costRecords    CostRecord[]
  siteCostRecords SiteCostRecord[]
  siteCostState   SiteCostState?

  @@index([enabled, status])
  @@index([type])
}

/// 上游分组/Token 监控单元（凭证级，承载所有凭证和独立指标）
model UpstreamKey {
  id                  Int       @id @default(autoincrement())
  upstreamId          Int
  upstream            Upstream  @relation(fields: [upstreamId], references: [id], onDelete: Cascade)
  /// 分组名（sub2api 的分组名 / new-api 的 Token 名/分组名）
  group               String    @default("default")
  /// 可选自定义标签
  label               String?
  /// 远端 API Token 名称（NEW_API）
  keyName             String?
  /// 远端 Token 实际绑定分组（NEW_API）
  groupName           String?
  /// 远端分组说明（NEW_API）
  groupDescription    String?
  /// 远端分组倍率（NEW_API）
  groupRateMultiplier Float?
  /// 远端 Token ID，按字符串保存以兼容不同实现
  remoteKeyId         String?
  /// 最近一次成功或部分成功同步元数据的时间
  metadataSyncedAt    DateTime?
  /// 最近一次元数据同步错误（不包含凭证）
  metadataError       String?
  /// AES-256-GCM 加密的 API Key（测速用）
  apiKeyEnc           String?
  /// new-api 系统访问令牌（查余额用，加密）
  accessTokenEnc      String?
  /// new-api 用户 ID
  userId              String?
  /// 本 key 的独立状态
  status              String    @default("UNKNOWN")
  lastBalance         Float?
  lastLatencyMs       Int?
  lastCollectedAt     DateTime?
  lastError           String?
  /// key 级测速模型覆盖（为空则用 upstream.testModel）
  testModel           String?
  enabled             Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  metrics        Metric[]
  incidents      Incident[]
  prices         PriceSnapshot[]
  usageSnapshots UsageSnapshot[]
  monitoredModels MonitoredModel[]
  costRecords     CostRecord[]
  costSyncState   CostSyncState?

  @@unique([upstreamId, group])
  @@index([upstreamId, enabled, status])
}

/// 分组下需要监测的模型。自动真实测试按最久未测试优先轮换，控制 Token 成本。
model MonitoredModel {
  id                  Int         @id @default(autoincrement())
  upstreamKeyId       Int
  upstreamKey         UpstreamKey @relation(fields: [upstreamKeyId], references: [id], onDelete: Cascade)
  modelName           String
  officialInputPrice  Float?
  officialOutputPrice Float?
  officialPriceSource String      @default("MANUAL")
  enabled             Boolean     @default(true)
  lastTestedAt        DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([upstreamKeyId, modelName])
  @@index([upstreamKeyId, enabled, lastTestedAt])
}

/// 每次采集的指标快照（时间序列）
model Metric {
  id             Int         @id @default(autoincrement())
  upstreamId     Int
  upstream       Upstream    @relation(fields: [upstreamId], references: [id], onDelete: Cascade)
  upstreamKeyId  Int
  upstreamKey    UpstreamKey @relation(fields: [upstreamKeyId], references: [id], onDelete: Cascade)
  balance        Float?
  latencyMs      Int?
  modelTestOk    Boolean?
  modelTestLatMs Int?
  streamTps      Float?
  streamFirstLat Int?
  streamTotalMs  Int?
  probeMode      String      @default("LIGHT")
  testModel      String?
  errorCode      String?
  success        Boolean     @default(false)
  errorMessage   String?
  recordedAt     DateTime    @default(now())

  @@index([upstreamId, recordedAt])
  @@index([upstreamKeyId, recordedAt])
  @@index([recordedAt])
}

/// 模型价格快照。价格统一按每 100 万 Token 保存，原币种同时保留。
model PriceSnapshot {
  id              Int          @id @default(autoincrement())
  upstreamId      Int
  upstream        Upstream     @relation(fields: [upstreamId], references: [id], onDelete: Cascade)
  upstreamKeyId   Int?
  upstreamKey     UpstreamKey? @relation(fields: [upstreamKeyId], references: [id], onDelete: SetNull)
  modelName       String
  currency        String       @default("CNY")
  inputPrice      Float?
  outputPrice     Float?
  cacheReadPrice  Float?
  cacheWritePrice Float?
  fixedPrice      Float?
  source          String       @default("MANUAL")
  rawData         Json?
  recordedAt      DateTime     @default(now())

  @@index([upstreamId, modelName, recordedAt])
  @@index([upstreamKeyId, modelName, recordedAt])
}

/// 上游用量接口返回的累计计费快照，用相邻差值自动计算实际倍率和价格。
model UsageSnapshot {
  id               Int         @id @default(autoincrement())
  upstreamId       Int
  upstream         Upstream    @relation(fields: [upstreamId], references: [id], onDelete: Cascade)
  upstreamKeyId    Int
  upstreamKey      UpstreamKey @relation(fields: [upstreamKeyId], references: [id], onDelete: Cascade)
  modelName        String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int         @default(0)
  cacheWriteTokens Int         @default(0)
  accountCost      Float?
  actualCost       Float
  recordedAt       DateTime    @default(now())

  @@index([upstreamKeyId, modelName, recordedAt])
  @@index([upstreamId, recordedAt])
}

/// 可聚合的成本流水。远端累计用量、远端逐条日志和本地探测都归一到此表。
model CostRecord {
  id                   Int         @id @default(autoincrement())
  upstreamId           Int
  upstream             Upstream    @relation(fields: [upstreamId], references: [id], onDelete: Cascade)
  upstreamKeyId        Int
  upstreamKey          UpstreamKey @relation(fields: [upstreamKeyId], references: [id], onDelete: Cascade)
  modelName             String
  inputTokens           Int         @default(0)
  outputTokens          Int         @default(0)
  cacheReadTokens       Int         @default(0)
  cacheWriteTokens      Int         @default(0)
  /// 上游美元额度等价成本；上游无法提供或无法计价时为空。
  costUsdCredit         Float?
  /// 按入账时 creditUsdPerCny 换算的实际人民币成本。
  costCny               Float?
  creditUsdPerCny       Float
  source                String
  completeness          String      @default("COMPLETE")
  estimated             Boolean     @default(false)
  sourceRef             String
  rawData               Json?
  occurredAt            DateTime
  recordedAt            DateTime    @default(now())

  @@unique([upstreamId, sourceRef])
  @@index([upstreamId, occurredAt])
  @@index([upstreamKeyId, occurredAt])
  @@index([upstreamKeyId, modelName, occurredAt])
}

/// 每个分组的成本能力、覆盖范围与同步健康状态。
model CostSyncState {
  id                Int         @id @default(autoincrement())
  upstreamKeyId     Int         @unique
  upstreamKey       UpstreamKey @relation(fields: [upstreamKeyId], references: [id], onDelete: Cascade)
  mode              String
  coverageStartedAt DateTime?
  cursor             String?
  lastSyncedAt       DateTime?
  lastError          String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([mode, lastSyncedAt])
}

/// 由站点共享余额相邻下降量生成的权威站点级消费流水。
model SiteCostRecord {
  id              Int      @id @default(autoincrement())
  upstreamId      Int
  upstream        Upstream @relation(fields: [upstreamId], references: [id], onDelete: Cascade)
  previousMetricId Int
  currentMetricId  Int
  balanceBefore   Float
  balanceAfter    Float
  costUsdCredit   Float
  costCny         Float
  creditUsdPerCny Float
  sourceRef       String
  occurredAt      DateTime
  recordedAt      DateTime @default(now())

  @@unique([upstreamId, sourceRef])
  @@index([upstreamId, occurredAt])
}

/// 站点余额成本的持久游标；Metric 被保留策略清理后仍可继续计算。
model SiteCostState {
  id                Int      @id @default(autoincrement())
  upstreamId        Int      @unique
  upstream          Upstream @relation(fields: [upstreamId], references: [id], onDelete: Cascade)
  lastMetricId      Int
  lastBalance       Float
  coverageStartedAt DateTime
  lastProcessedAt   DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// 告警事件
model Incident {
  id            Int          @id @default(autoincrement())
  upstreamId    Int
  upstream      Upstream     @relation(fields: [upstreamId], references: [id], onDelete: Cascade)
  upstreamKeyId Int?
  upstreamKey   UpstreamKey? @relation(fields: [upstreamKeyId], references: [id], onDelete: SetNull)
  type          String
  severity      String       @default("WARNING")
  message       String
  metricValue   Float?
  resolved      Boolean      @default(false)
  resolvedAt    DateTime?
  createdAt     DateTime     @default(now())

  @@index([upstreamId, resolved, createdAt])
  @@index([upstreamKeyId, resolved, createdAt])
  @@index([resolved, createdAt])
}

// ============ 配置表 ============

model AlertRule {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  metric      String
  operator    String   @default("lt")
  threshold   Float
  severity    String   @default("WARNING")
  cooldownMin Int      @default(30)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AlertChannel {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  type      String   @default("feishu")
  config    Json
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
